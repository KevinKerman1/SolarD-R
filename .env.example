# Lead-proxy server env vars (server/index.js)
# Copy to .env locally; set these in Render/Railway dashboard for production.

# reCAPTCHA v3 SECRET key (NOT the sitekey). Get from https://www.google.com/recaptcha/admin
# Sitekey already in HTML is 6Le4i4wsAAAAAOG4Ebu3E7mWoye8GFqvzz-CZ6wW
RECAPTCHA_SECRET=

# GoHighLevel webhook URL — where verified leads get forwarded.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/8uDfZwEms36rykE5axKL/webhook-trigger/4d2a4a76-ee23-4cc1-8fb9-660a88be5016

# Minimum reCAPTCHA v3 score to accept (0.0 = bot, 1.0 = human). Start at 0.5.
MIN_SCORE=0.5

# Comma-separated list of allowed origins for CORS.
ALLOWED_ORIGIN=https://solardetachpro.com,https://www.solardetachpro.com

# Port (Render/Railway set this automatically).
PORT=3000
